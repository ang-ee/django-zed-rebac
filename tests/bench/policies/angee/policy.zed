definition agents/agent {
    relation actor: auth/user // rebac:field=user
    relation admin: angee/role // rebac:const=admin
    relation caller: auth/group#member | auth/user
    relation editor: auth/group#member | auth/user
    relation owner: auth/user // rebac:field=owner
    relation reader: auth/group#member | auth/user

    permission call = ((owner + caller) + admin->member)
    permission create = admin->member
    permission delete = (owner + admin->member)
    permission read = (((owner + reader) + editor) + admin->member)
    permission share = ((owner + editor) + admin->member)
    permission share_call = (owner + admin->member)
    permission transfer = (owner + admin->member)
    permission write = ((owner + editor) + admin->member)
    permission write__owner = transfer
    permission write__resource_reader = admin->member
}

definition agents/inference_model {
    relation admin: angee/role // rebac:const=admin
    relation provider: agents/inference_provider // rebac:field=provider

    permission create = admin->member
    permission delete = (provider->write + admin->member)
    permission read = (provider->read + admin->member)
    permission write = (provider->write + admin->member)
}

definition agents/inference_provider {
    relation admin: angee/role // rebac:const=admin
    relation integration: integrate/integration // rebac:field=integration_ptr

    permission create = admin->member
    permission delete = (integration->write + admin->member)
    permission read = (integration->read + admin->member)
    permission write = (integration->write + admin->member)
    permission write__owner = integration->transfer
}

definition agents/mcp_server {
    relation admin: angee/role // rebac:const=admin
    relation selected_agent: agents/agent // rebac:field=agents

    permission create = admin->member
    permission delete = admin->member
    permission read = (selected_agent->actor + admin->member)
    permission write = admin->member
}

definition agents/session {
    relation admin: angee/role // rebac:const=admin
    relation agent: agents/agent // rebac:field=agent
    relation user: auth/user // rebac:field=user

    permission create = ((user & agent->call) + admin->member)
    permission delete = (agent->delete + admin->member)
    permission post = ((user & agent->call) + admin->member)
    permission read = ((user + agent->actor) + admin->member)
    permission write = ((user + agent->actor) + admin->member)
}

definition agents/skill {
    relation admin: angee/role // rebac:const=admin
    relation source: integrate_vcs/source // rebac:field=source

    permission create = admin->member
    permission delete = (source->write + admin->member)
    permission read = (source->read + admin->member)
    permission write = (source->write + admin->member)
}

definition agents/tool_grant {
    relation admin: angee/role // rebac:const=admin
    relation approver: auth/user
    relation grantee: auth/group#member | auth/user
    relation person: iam/kind // rebac:const=person
    relation role: agents/toolrole
    relation selected_agent: auth/user // rebac:field=agents__user
    relation server: agents/mcp_server // rebac:field=server

    permission create = admin->member
    permission delete = (server->write + admin->member)
    permission read = (server->read + admin->member)
    permission use = (((selected_agent + grantee) + role->effective_member) + admin->member)
    permission use_approved = ((((grantee + role->effective_member) & approver) + admin->member) & person->active_member)
    permission write = (server->write + admin->member)
}

definition agents/toolrole {
    relation admin: angee/role // rebac:const=admin
    relation includes: agents/toolrole
    relation member: angee/role:admin#member | auth/group#member | auth/user

    permission effective_member = ((member + includes->effective_member) + admin->member)
}

definition agents/turn {
    relation session: agents/session // rebac:field=session

    permission create = session->write
    permission delete = session->delete
    permission read = session->read
    permission write = session->write
}

definition angee/role {
    relation member: auth/group#member | auth/user

    permission effective_member = member
}

definition auth/group {
    relation admin: angee/role // rebac:const=admin
    relation member: auth/user

    permission create = admin->member
    permission delete = admin->member
    permission read = (member + admin->member)
    permission write = admin->member
}

definition auth/user {
    relation active: iam/audience // rebac:const={"filters":{"is_active":true},"target_id":"active"}
    relation admin: angee/role // rebac:const=admin
    relation directory: iam/directory // rebac:const=main
    relation directory_reader: auth/user
    relation person: parties/person // rebac:field={"filters":{"is_active":true},"path":"person"}
    relation self: auth/user // rebac:attribute={"field":"id"}
    relation staff: iam/audience // rebac:const={"filters":{"is_staff":true},"target_id":"staff"}

    permission active_account = (((((colleague + view_as) + issue_password) + reset_password) + issue_sign_in_link) & active->disclosed)
    permission administer = admin->member
    permission colleague = ((self + list) + person->read)
    permission create = admin->member
    permission delete = admin->member
    permission issue_password = admin->member
    permission issue_sign_in_link = admin->member
    permission list = ((directory_reader + directory->reader) + admin->member)
    permission nonstaff_account = (((((((view_as + write) + set_active) + rename) + reset_password) + issue_password) + issue_sign_in_link) - staff->disclosed)
    permission read = authenticated
    permission read__email = read_private
    permission read__is_active = read_private
    permission read__is_staff = read_private
    permission read__last_login = read_private
    permission read__preferences = read_private
    permission read__username = read_private
    permission read_private = (self + list)
    permission rename = admin->member
    permission reset_password = admin->member
    permission set_active = admin->member
    permission view_as = admin->member
    permission write = admin->member
    permission write__date_joined = admin->member
    permission write__email = admin->member
    permission write__is_active = admin->member
    permission write__is_staff = admin->member
    permission write__is_superuser = admin->member
    permission write__kind = admin->member
    permission write__last_login = admin->member
    permission write__password = admin->member
    permission write__preferences = admin->member
    permission write__username = admin->member
}

definition calendar/calendar {
    relation admin: angee/role // rebac:const=admin
    relation directory: integrate/integration // rebac:field=record_links__stream__integration
    relation editor: auth/group#member | auth/user
    relation free_busy: auth/group#member | auth/user
    relation holder: auth/user // rebac:field=party__person__user
    relation owner: auth/user // rebac:field=owner
    relation party: parties/party // rebac:field=party
    relation reader: auth/group#member | auth/user

    permission create = (party->write + admin->member)
    permission delete = ((owner + holder) + admin->member)
    permission read = read_granted
    permission read_granted = (reader + write)
    permission see_busy = (read + free_busy)
    permission share = (((owner + holder) + editor) + admin->member)
    permission statement_source = directory
    permission transfer = (owner + admin->member)
    permission write = (((owner + holder) + editor) + admin->member)
    permission write__owner = transfer
    permission write_statements = (write + statement_source)
}

definition calendar/calendar_source {
    relation admin: angee/role // rebac:const=admin
    relation integration: integrate/integration // rebac:field=integration_ptr

    permission create = authenticated
    permission delete = (integration->write + admin->member)
    permission read = (integration->read + admin->member)
    permission write = (integration->write + admin->member)
    permission write__owner = integration->transfer
}

definition calendar/event {
    relation admin: angee/role // rebac:const=admin
    relation calendar: calendar/calendar // rebac:field=calendar
    relation default_calendar: calendar/calendar // rebac:field={"filters":{"visibility":"default"},"path":"calendar"}
    relation public_calendar: calendar/calendar // rebac:field={"filters":{"visibility":"public"},"path":"calendar"}

    permission create = (calendar->write + admin->member)
    permission delete = (calendar->write + admin->member)
    permission read = read_granted
    permission read_granted = ((default_calendar->read + public_calendar->see_busy) + write)
    permission see_busy = (calendar->see_busy + admin->member)
    permission write = (calendar->write + admin->member)
}

definition calendar/event_attendee {
    relation admin: angee/role // rebac:const=admin
    relation event: calendar/event // rebac:field=event

    permission create = (event->write + admin->member)
    permission delete = (event->write + admin->member)
    permission read = (event->read + admin->member)
    permission write = (event->write + admin->member)
}

definition checklists/evidence {
    relation result: checklists/result // rebac:field=result

    permission create = result->target_write
    permission delete = nil
    permission hidden = ((authenticated + anonymous) - record_read)
    permission read = (result->target_read & record_read)
    permission record_read = nil
    permission write = nil
}

definition checklists/result {
    relation evidence: checklists/evidence // rebac:field=evidence

    permission create = target_write
    permission delete = nil
    permission evidence_hidden = evidence->hidden
    permission read = (target_read - evidence_hidden)
    permission target_read = nil
    permission target_write = nil
    permission write = nil
}

definition dashboards/dashboard {
    relation admin: angee/role // rebac:const=admin
    relation editor: auth/group#member | auth/user
    relation owner: auth/user // rebac:field=owner
    relation shared: dashboards/dashboard // rebac:const={"filters":{"is_baseline":true},"target_id":"shared"}
    relation trashed: dashboards/dashboard // rebac:const={"filters":{"is_trashed":true},"target_id":"trashed"}
    relation viewer: auth/group#member | auth/user

    permission conceal = authenticated
    permission create = (authenticated - shared->shared_reader)
    permission delete = (owner + admin->member)
    permission read = ((read_granted - withheld) + delete)
    permission read_granted = (((shared->shared_reader + owner) + viewer) + editor)
    permission reset = owner
    permission share = (owner + admin->member)
    permission shared_reader = authenticated
    permission transfer = ((owner + admin->member) - shared->shared_reader)
    permission withheld = trashed->conceal
    permission write = ((owner + editor) + admin->member)
    permission write__is_baseline = nil
    permission write__owner = transfer
}

definition dashboards/widget {
    relation dashboard: dashboards/dashboard // rebac:field=dashboard

    permission create = dashboard->write
    permission delete = dashboard->write
    permission read = dashboard->read
    permission write = dashboard->write
}

definition decisions/decision {
    relation access_need: intake/need // rebac:field=access_needs
    relation admin: angee/role // rebac:const=admin
    relation assignee: auth/user // rebac:field=assignees
    relation person: iam/kind // rebac:const=person
    relation requester: auth/user // rebac:field=requester
    relation requesting_step: workflows/step_run // rebac:field=requesting_steps

    permission act = (eligible + ((admin->member & person->active_actor) - owner_managed))
    permission create = admin->member
    permission delete = admin->member
    permission eligible = ((((assignee - requester) - owner_managed) + owner_eligible) & person->active_actor)
    permission owner_eligible = (nil + access_need->share)
    permission owner_managed = (nil + access_need->decision_managed)
    permission read = (read_granted + requesting_step->operate)
    permission read_granted = ((assignee + requester) + admin->member)
    permission write = admin->member
}

definition decisions/record {
    relation admin: angee/role // rebac:const=admin
    relation decision: decisions/decision // rebac:field=decision

    permission create = admin->member
    permission delete = admin->member
    permission read = decision->read
    permission write = admin->member
}

definition extraction/extraction {
    relation admin: angee/role // rebac:const=admin
    relation creator: auth/user // rebac:field=created_by
    relation file: storage/file // rebac:field=file
    relation message: messaging/message // rebac:field=message
    relation viewer: auth/group#member | auth/user

    permission read = ((((creator + viewer) + file->read) + message->read) + admin->member)
    permission read__document_map = read__result
    permission read__outcome = read__result
    permission read__result = (read & (file->read + message->read))
    permission read__retired_identities = read__result
    permission share = (creator + admin->member)
}

definition extraction/extraction_page {
    relation extraction: extraction/extraction // rebac:field=extraction
    relation source: extraction/extraction_source // rebac:field=source

    permission read = (extraction->read & source->read_content)
}

definition extraction/extraction_part {
    relation extraction: extraction/extraction // rebac:field=extraction
    relation source: extraction/extraction_source // rebac:field=source

    permission read = (extraction->read & source->read_content)
}

definition extraction/extraction_source {
    relation extraction: extraction/extraction // rebac:field=extraction
    relation file: storage/file // rebac:field=file
    relation message_part: messaging/part // rebac:field=message_part

    permission read = extraction->read
    permission read_content = (file->read + message_part->read)
}

definition iam/audience {
    permission disclosed = authenticated
}

definition iam/directory {
    relation reader: auth/user
}

definition iam/kind {
    relation active_actor: auth/user // rebac:attribute={"field":"is_active","resource":"person","value":true}
    relation active_member: auth/user // rebac:attribute={"field":"kind","filters":{"is_active":true},"resource":"person","value":"person"}
    relation member: auth/user // rebac:attribute={"field":"kind","resource":"person","value":"person"}
}

definition iam/protected {
    relation admin: angee/role // rebac:const=admin

    permission member = admin->effective_member
}

definition intake/need {
    relation person: iam/kind // rebac:const=person
    relation project: projects/project // rebac:field=project
    relation task: projects/task // rebac:field=task

    permission create = (task->write + project->write)
    permission decision_managed = person->active_actor
    permission delete = (task->write + project->write)
    permission read = (task->read + project->read)
    permission read__access_decision = share
    permission read__admitted_user = share
    permission read__claimed_email = (task->write + project->write)
    permission share = (task->share + project->share)
    permission write = (task->write + project->write)
    permission write__admitted_user = share
    permission write__party = (task->share + project->share)
}

definition integrate/credential {
    relation admin: angee/role // rebac:const=admin
    relation user: auth/user // rebac:field=user

    permission create = admin->member
    permission delete = (user + admin->member)
    permission read = (user + admin->member)
    permission write = (user + admin->member)
}

definition integrate/external_account {
    relation admin: angee/role // rebac:const=admin
    relation owner: auth/user // rebac:field=owner

    permission create = admin->member
    permission delete = (owner + admin->member)
    permission read = (owner + admin->member)
    permission transfer = admin->member
    permission write = (owner + admin->member)
    permission write__owner = transfer
}

definition integrate/integration {
    relation admin: angee/role // rebac:const=admin
    relation channel_team: spaces/group // rebac:field=channel__team
    relation owner: auth/user // rebac:field=owner
    relation project: projects/project // rebac:field=project_bindings__project
    relation reader: auth/group#member | auth/user

    permission create = admin->member
    permission delete = (((owner + admin->member) + project->write) + channel_team->write)
    permission read = ((((owner + reader) + admin->member) + project->read) + channel_team->post)
    permission resume = admin->member
    permission retry_discovery = (owner + admin->member)
    permission transfer = (owner + admin->member)
    permission write = (((owner + admin->member) + project->write) + channel_team->write)
    permission write__owner = transfer
}

definition integrate/oauth_client {
    relation admin: angee/role // rebac:const=admin

    permission create = admin->member
    permission delete = admin->member
    permission read = admin->member
    permission write = admin->member
}

definition integrate/record_link {
    relation stream: integrate/sync_stream // rebac:field=stream

    permission create = stream->write
    permission delete = stream->delete
    permission read = stream->read
    permission write = stream->write
}

definition integrate/sync_stream {
    relation integration: integrate/integration // rebac:field=integration

    permission create = integration->write
    permission delete = integration->delete
    permission read = (integration + integration->read)
    permission write = integration->write
}

definition integrate/vendor {
    relation admin: angee/role // rebac:const=admin

    permission create = admin->member
    permission delete = admin->member
    permission read = admin->member
    permission write = admin->member
}

definition integrate/webhook_subscription {
    relation admin: angee/role // rebac:const=admin
    relation owner: auth/user // rebac:field=owner

    permission create = admin->member
    permission delete = (owner + admin->member)
    permission read = (owner + admin->member)
    permission transfer = (owner + admin->member)
    permission write = (owner + admin->member)
    permission write__owner = transfer
}

definition integrate_vcs/repository {
    relation admin: angee/role // rebac:const=admin
    relation vcs_bridge: integrate_vcs/vcs_bridge // rebac:field=vcs_bridge

    permission create = admin->member
    permission delete = (vcs_bridge->write + admin->member)
    permission read = (vcs_bridge->read + admin->member)
    permission write = (vcs_bridge->write + admin->member)
}

definition integrate_vcs/source {
    relation admin: angee/role // rebac:const=admin
    relation repository: integrate_vcs/repository // rebac:field=repository

    permission create = admin->member
    permission delete = (repository->write + admin->member)
    permission read = (repository->read + admin->member)
    permission write = (repository->write + admin->member)
}

definition integrate_vcs/template {
    relation admin: angee/role // rebac:const=admin
    relation source: integrate_vcs/source // rebac:field=source

    permission create = admin->member
    permission delete = (source->write + admin->member)
    permission read = (source->read + admin->member)
    permission write = (source->write + admin->member)
}

definition integrate_vcs/vcs_bridge {
    relation admin: angee/role // rebac:const=admin
    relation integration: integrate/integration // rebac:field=integration_ptr

    permission create = admin->member
    permission delete = (integration->write + admin->member)
    permission read = (integration->read + admin->member)
    permission write = (integration->write + admin->member)
    permission write__owner = integration->transfer
}

definition knowledge/link {
    relation source_page: knowledge/page // rebac:field=source_page

    permission delete = source_page->write
    permission read = source_page->read
    permission write = source_page->write
}

definition knowledge/markdown_page {
    relation page: knowledge/page // rebac:field=page_ptr

    permission create = page->write
    permission delete = page->write
    permission read = page->read
    permission write = page->write
}

definition knowledge/page {
    relation parent: knowledge/page // rebac:field=parent
    relation trashed: knowledge/page // rebac:const={"filters":{"is_trashed":true},"target_id":"trashed"}
    relation vault: knowledge/vault // rebac:field=vault
    relation viewer: auth/group#member | auth/user

    permission conceal = authenticated
    permission create = vault->write
    permission delete = (parent->delete + vault->delete)
    permission read = ((read_granted - withheld) + vault->delete)
    permission read_as_subject = (viewer + vault->read_as_subject)
    permission read_granted = ((viewer + parent->read_granted) + vault->read)
    permission withheld = (trashed->conceal + vault->withheld)
    permission write = ((write_granted - withheld) + vault->delete)
    permission write_as_subject = vault->write_as_subject
    permission write_granted = (parent->write_granted + vault->write)
}

definition knowledge/record_binding {
    relation note: notes/note // rebac:field=target
    relation page: knowledge/page // rebac:field=page
    relation project: projects/project // rebac:field=target
    relation task: projects/task // rebac:field=target
    relation vault: knowledge/vault // rebac:field=vault

    permission create = ((page->write + vault->write) & target_write)
    permission delete = ((page->write + vault->write) & target_write)
    permission read = ((page->read + vault->read) & target_read)
    permission target_read = ((nil + (task->read + project->read)) + note->read)
    permission target_write = ((nil + (task->write + project->write)) + note->write)
    permission write = nil
}

definition knowledge/role {
    relation member: angee/role:admin#member | auth/group#member | auth/user
}

definition knowledge/vault {
    relation admin: angee/role // rebac:const=admin
    relation editor: auth/group#member | auth/user
    relation knowledge_admin: knowledge/role // rebac:const=knowledge_admin
    relation owner: auth/user // rebac:field=owner
    relation project: projects/project // rebac:field=project_bindings__project
    relation team: spaces/group // rebac:field=team
    relation trashed: knowledge/vault // rebac:const={"filters":{"is_trashed":true},"target_id":"trashed"}
    relation vault_admin: knowledge/role // rebac:const=vault_admin
    relation vault_editor: knowledge/role // rebac:const=vault_editor
    relation vault_viewer: knowledge/role // rebac:const=vault_viewer
    relation viewer: auth/group#member | auth/user

    permission conceal = authenticated
    permission create = authenticated
    permission delete = (((owner + vault_admin->member) + knowledge_admin->member) + admin->member)
    permission read = ((read_granted - withheld) + delete)
    permission read_as_subject = (((((((owner + editor) + viewer) + vault_viewer->member) + vault_editor->member) + vault_admin->member) + knowledge_admin->member) + admin->member)
    permission read_granted = (((((((((owner + editor) + viewer) + vault_viewer->member) + vault_editor->member) + vault_admin->member) + knowledge_admin->member) + admin->member) + project->read) + team->post)
    permission share = ((owner + admin->member) + project->share)
    permission transfer = (owner + admin->member)
    permission withheld = trashed->conceal
    permission write = ((write_granted - withheld) + delete)
    permission write__owner = transfer
    permission write__team = share
    permission write_as_subject = (((((owner + editor) + vault_editor->member) + vault_admin->member) + knowledge_admin->member) + admin->member)
    permission write_granted = (((((((owner + editor) + vault_editor->member) + vault_admin->member) + knowledge_admin->member) + admin->member) + project->write) + team->write)
}

definition knowledge_graph_pgvector/entity {
    relation evidence: knowledge_graph_pgvector/passage // rebac:field=mentions__passage
    relation vault: knowledge/vault // rebac:field=vault

    permission delete = vault->delete
    permission read = (vault->read & evidence->graph_read)
}

definition knowledge_graph_pgvector/entity_edge {
    relation passage: knowledge_graph_pgvector/passage // rebac:field=passage

    permission delete = passage->delete
    permission read = passage->graph_read
}

definition knowledge_graph_pgvector/entity_mention {
    relation passage: knowledge_graph_pgvector/passage // rebac:field=passage

    permission delete = passage->delete
    permission read = passage->graph_read
}

definition knowledge_graph_pgvector/passage {
    relation live_page: knowledge/page // rebac:field={"filters":{"page__is_trashed":false,"page__vault__is_trashed":false},"path":"page"}
    relation page: knowledge/page // rebac:field=page

    permission delete = page->write
    permission graph_read = live_page->read
    permission read = page->read
    permission write = page->write
}

definition knowledge_graph_pgvector/passage_embedding {
    relation model: agents/inference_model // rebac:field=model
    relation passage: knowledge_graph_pgvector/passage // rebac:field=passage

    permission delete = (passage->write + model->delete)
    permission read = passage->read
    permission write = passage->write
}

definition knowledge_integrate_notion/notion_connection {
    relation admin: angee/role // rebac:const=admin
    relation integration: integrate/integration // rebac:field=integration_ptr

    permission create = admin->member
    permission delete = integration->write
    permission read = integration->read
    permission write = integration->write
    permission write__owner = integration->transfer
}

definition messaging/channel {
    relation admin: angee/role // rebac:const=admin
    relation annotator: auth/group#member | auth/user
    relation integration: integrate/integration // rebac:field=integration_ptr
    relation reader: auth/group#member | auth/user
    relation replier: auth/group#member | auth/user

    permission annotate = (annotator + write)
    permission create = admin->member
    permission delete = (integration->write + admin->member)
    permission read = (((integration->read + reader) + replier) + admin->member)
    permission reply = ((replier + integration->write) + admin->member)
    permission write = (integration->write + admin->member)
    permission write__owner = integration->transfer
    permission write__team = (integration->owner + admin->member)
}

definition messaging/message {
    relation admin: angee/role // rebac:const=admin
    relation channel: messaging/channel // rebac:field=channel
    relation editor: auth/group#member | auth/user
    relation identity_role: provenance/role // rebac:const=messaging_identity_source
    relation reader: auth/group#member | auth/user
    relation thread: messaging/thread // rebac:field=thread
    relation trashed: messaging/message // rebac:const={"filters":{"is_trashed":true},"target_id":"trashed"}

    permission annotate = (((write + thread->annotate_granted) + channel->annotate) & read)
    permission conceal = authenticated
    permission create = authenticated
    permission delete = (((thread->delete + channel->write) + editor) + admin->member)
    permission identity_source = identity_role->effective_member
    permission read = (((thread->read + read_granted) - withheld) + withheld_keeper)
    permission read_granted = ((channel->read + editor) + reader)
    permission read_inbox = (((thread->read_inbox + read_granted) - withheld) + withheld_keeper)
    permission send_held = (channel->write + admin->member)
    permission withheld = trashed->conceal
    permission withheld_keeper = ((channel->write + identity_source) + admin->member)
    permission write = ((((thread->write + channel->write) + editor) + identity_source) + admin->member)
}

definition messaging/message_edge {
    relation admin: angee/role // rebac:const=admin
    relation dst: messaging/message // rebac:field=dst
    relation editor: auth/group#member | auth/user
    relation reader: auth/group#member | auth/user
    relation src: messaging/message // rebac:field=src

    permission create = authenticated
    permission delete = ((src->delete + dst->delete) + admin->member)
    permission read = ((((src->read & dst->read) + editor) + reader) + admin->member)
