    permission share = group->manage_roster
    permission withheld = nil
    permission write = group->write
    permission write__owner = group->transfer
}

definition work/stage {
    relation queue: work/queue // rebac:field=queue

    permission create = queue->write
    permission delete = queue->write
    permission read = queue->read
    permission write = queue->write
}

definition workflows/run {
    relation admin: angee/role // rebac:const=admin
    relation operator: auth/group#member | auth/user
    relation parent: workflows/run // rebac:field=parent_step__run
    relation reader: auth/group#member | auth/user
    relation run_as: auth/user // rebac:field=run_as
    relation workflow: workflows/workflow // rebac:field=version__workflow

    permission create = (workflow->start + admin->member)
    permission delete = admin->member
    permission operate = (((run_as + operator) + workflow->operator) + admin->member)
    permission read = (((operate + workflow->monitor) + reader) + parent->read)
    permission read__error = write
    permission write = (operate + workflow->write)
}

definition workflows/step_attempt {
    relation admin: angee/role // rebac:const=admin
    relation step_run: workflows/step_run // rebac:field=step_run

    permission create = admin->member
    permission delete = admin->member
    permission read = (step_run->read + admin->member)
    permission read__error = step_run->read_error
    permission read__stacktrace = step_run->operate
    permission write = admin->member
}

definition workflows/step_record {
    relation admin: angee/role // rebac:const=admin
    relation run: workflows/run // rebac:field=run

    permission create = admin->member
    permission delete = admin->member
    permission read = (run->read + admin->member)
    permission write = admin->member
}

definition workflows/step_run {
    relation admin: angee/role // rebac:const=admin
    relation run: workflows/run // rebac:field=run

    permission create = admin->member
    permission delete = admin->member
    permission operate = run->operate
    permission read = (run->read + admin->member)
    permission read_error = operate
    permission write = admin->member
}

definition workflows/step_watch {
    relation admin: angee/role // rebac:const=admin
    relation step_run: workflows/step_run // rebac:field=step_run

    permission create = admin->member
    permission delete = admin->member
    permission read = (step_run->read + admin->member)
    permission write = admin->member
}

definition workflows/trigger {
    relation admin: angee/role // rebac:const=admin
    relation workflow: workflows/workflow // rebac:field=workflow

    permission create = (workflow->write + admin->member)
    permission delete = (workflow->write + admin->member)
    permission monitor = (workflow->monitor + admin->member)
    permission read = (workflow->read + admin->member)
    permission write = (workflow->write + admin->member)
}

definition workflows/trigger_event {
    relation admin: angee/role // rebac:const=admin
    relation started_run: workflows/run // rebac:field=started_run
    relation trigger: workflows/trigger // rebac:field=trigger

    permission create = admin->member
    permission delete = admin->member
    permission read = ((trigger->write + started_run->operate) + admin->member)
    permission write = admin->member
}

definition workflows/version {
    relation admin: angee/role // rebac:const=admin
    relation workflow: workflows/workflow // rebac:field=workflow

    permission create = (workflow->write + admin->member)
    permission delete = admin->member
    permission read = (workflow->read + admin->member)
    permission write = admin->member
}

definition workflows/workflow {
    relation admin: angee/role // rebac:const=admin
    relation continues: workflows/workflow
    relation editor: auth/group#member | auth/user
    relation operator: auth/group#member | auth/user
    relation owner: auth/user // rebac:field=owner
    relation principal: auth/user // rebac:field=user
    relation starter: auth/group#member | auth/user
    relation viewer: auth/group#member | auth/user

    permission create = admin->member
    permission delete = (owner + admin->member)
    permission monitor = (((owner + editor) + viewer) + admin->member)
    permission read = (((((owner + editor) + viewer) + starter) + operator) + admin->member)
    permission read__draft = monitor
    permission read__draft_revision = monitor
    permission read__layout = monitor
    permission start = ((((((principal + owner) + editor) + starter) + operator) + continues->principal) + admin->member)
    permission transfer = (owner + admin->member)
    permission write = ((owner + editor) + admin->member)
    permission write__owner = transfer
}
